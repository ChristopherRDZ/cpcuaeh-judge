[Unit]
Description=DMOJ judge bridge
After=network.target mariadb.service redis-server.service

[Service]
Type=simple
User=dmoj-bridge
Group=dmoj-bridge
WorkingDirectory=/srv/dmoj/site
ExecStart=/srv/dmoj/venv/bin/python manage.py runbridged
Restart=on-failure
RestartSec=5
UMask=0022
Environment=HOME=/nonexistent
# Secrets that dmoj/local_settings.example.py reads; a file only root can read.
EnvironmentFile=/etc/dmoj/site.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/srv/dmoj/venv/bin:/usr/local/bin:/usr/bin:/bin
LogsDirectory=dmoj-bridge
LogsDirectoryMode=0700
BindReadOnlyPaths=/srv/dmoj/site /srv/dmoj/venv
ReadWritePaths=/srv/dmoj/problems
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
